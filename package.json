{
  "name": "ruzain-engineering-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "node --test scripts/site.test.mjs",
    "test:browser": "playwright test",
    "preview": "node scripts/serve.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/three": "0.187.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
